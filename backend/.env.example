NODE_ENV=development
PORT=4000

# PostgreSQL — the DB runs in Docker:
#   docker compose up -d db
# Default credentials come from the root .env (POSTGRES_USER/PASSWORD/DB)
DATABASE_URL="postgresql://navatra:navatra_dev_pw@localhost:5432/navatra?schema=public"

# Auth secrets — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Cloudinary (optional — when unset, uploads fall back to local disk in backend/uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS origins
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
