NODE_ENV=development
PORT=4000

# SQLite — stored as a file; in Docker it lives on a persistent volume.
DATABASE_URL="file:./dev.db"

# Auth secrets — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Redis — used for API/homepage caching. When unavailable the app falls
# back to an in-memory cache and keeps serving from SQLite.
REDIS_URL=redis://localhost:6379

# MinIO — object storage for media. When unavailable the app falls back
# to local disk under backend/uploads.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=navatra
MINIO_SECRET_KEY=navatra_dev_secret
MINIO_BUCKET=news-media
# Serve objects through the API proxy (/minio/<bucket>/<key>) so images
# work identically in dev and Docker without exposing MinIO directly.
MINIO_PUBLIC_URL=/minio

# CORS origins
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
