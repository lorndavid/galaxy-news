// ============================================================
// Navatra 4K TV — database schema (PostgreSQL + Prisma)
// ============================================================

generator client {
  provider      = "prisma-client-js"
  // Docker runtime (node:20-slim + Debian OpenSSL 3) needs this target in
  // addition to the local "native" binary.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Users & auth ----------
// Note: role/status columns use Strings validated at the application layer
// (see src/constants.ts) for cross-database portability.

// Roles: SUPER_ADMIN | ADMIN | EDITOR | AUTHOR

model User {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  passwordHash  String
  role          String         @default("AUTHOR") // SUPER_ADMIN | ADMIN | EDITOR | AUTHOR
  avatar        String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  articles      Article[]
  media         Media[]
  refreshTokens RefreshToken[]
  activityLogs  ActivityLog[]

  @@index([role])
  @@index([isActive])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------- Content ----------

model Category {
  id           Int       @id @default(autoincrement())
  name         String
  nameEn       String?   // English display name (falls back to name)
  nameZh       String?   // Chinese display name (falls back to nameEn)
  slug         String    @unique
  description  String?
  descriptionEn String?
  descriptionZh String?
  image        String?
  color        String?   @default("#0b1c39")
  isActive     Boolean   @default(true)
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  articles     Article[]

  @@index([slug])
  @@index([isActive, sortOrder])
}

model Tag {
  id       Int          @id @default(autoincrement())
  name     String       @unique
  nameEn   String?      // English tag name (falls back to name)
  slug     String       @unique
  articles ArticleTag[]

  @@index([slug])
}

model Article {
  id            Int          @id @default(autoincrement())
  title         String
  titleEn       String?      // English title (falls back to title)
  titleZh       String?      // Chinese title (falls back to titleEn)
  slug          String       @unique
  excerpt       String?
  excerptEn     String?
  excerptZh     String?
  content       String       @default("")
  contentEn     String?      // English content (falls back to content)
  contentZh     String?      // Chinese content (falls back to contentEn)
  featuredImage String?
  authorId      Int
  author        User         @relation(fields: [authorId], references: [id])
  categoryId    Int
  category      Category     @relation(fields: [categoryId], references: [id])
  status        String       @default("DRAFT") // DRAFT | PUBLISHED | SCHEDULED | ARCHIVED
  isFeatured    Boolean      @default(false)
  isBreaking    Boolean      @default(false)
  views         Int          @default(0)
  galleryColumns Int         @default(3) // gallery grid columns (2-4)
  publishedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  tags          ArticleTag[]
  images        ArticleImage[]
  comments      Comment[]
  viewLogs      ViewLog[]
  telegramPublications TelegramPublication[]

  @@index([slug])
  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([authorId])
  @@index([views])
  @@index([isFeatured])
  @@index([isBreaking])
}

// Per-view event log — powers the dashboard views-over-time chart.
// One row per non-bot article view; the article counter stays the source
// of truth for totals, this table adds the time dimension.
// One publication record per article per destination (composite unique on
// articleId + chatId) — powers the Telegram auto-publish status shown in
// the admin, per-chat duplicate protection and manual retries.
// Statuses: PENDING | PROCESSING | PUBLISHED | FAILED
model TelegramPublication {
  id                 Int       @id @default(autoincrement())
  articleId          Int
  article            Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  status             String    @default("PENDING") // PENDING | PROCESSING | PUBLISHED | FAILED
  telegramMessageId  Int?      // Telegram message_id of the sent photo
  chatId             String?   // destination chat (@username or numeric id)
  languageMode       String    @default("both") // both | kh | en
  attempts           Int       @default(0)
  errorMessage       String?
  nextAttemptAt      DateTime? // backoff schedule for retries
  publishedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([articleId, chatId])
  @@index([articleId])
  @@index([status])
}

model ViewLog {
  id        Int      @id @default(autoincrement())
  articleId Int
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())

  @@index([viewedAt])
  @@index([articleId, viewedAt])
}

model ArticleTag {
  articleId Int
  tagId     Int
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

// Gallery images for an article (ordered by sortOrder)
model ArticleImage {
  id           Int      @id @default(autoincrement())
  articleId    Int
  article      Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  mediaId      Int
  media        Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  altText      String?
  caption      String?
  title        String?  // per-image title (shown above description)
  description  String?  // per-image description text
  cropPosition String?  @default("center") // center | top | bottom | left | right
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  @@unique([articleId, mediaId])
  @@index([articleId])
  @@index([mediaId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  articleId Int
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  name      String
  email     String
  content   String
  status    String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([articleId, status])
  @@index([status])
}

// ---------- Media ----------

model Media {
  id          Int      @id @default(autoincrement())
  publicId    String?  // legacy Cloudinary public id (kept for migration)
  objectKey   String?  // MinIO object key (bucket-relative path)
  url         String
  secureUrl   String?
  fileName    String
  width       Int?
  height      Int?
  format      String?
  size        Int?
  altText     String?
  caption     String?
  folder      String   @default("articles") // articles | categories | authors | ads | gallery | site
  createdById Int?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  articleImages ArticleImage[]
  createdAt   DateTime @default(now())

  @@index([createdById])
  @@index([folder])
}

// ---------- Monetization ----------

model Advertisement {
  id        Int       @id @default(autoincrement())
  name      String
  title     String?   // optional headline shown with the banner
  image     String
  link      String?
  target    String    @default("_blank") // _blank | _self
  position  String    @default("sidebar") // header | sidebar | inline | footer | homepage-top | homepage-middle | homepage-bottom | article-top | article-middle | article-bottom | category-top | category-bottom
  device    String    @default("all") // all | desktop | tablet | mobile
  priority  Int       @default(0) // higher wins when multiple banners share a slot
  isActive  Boolean   @default(true)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([position, isActive])
  @@index([position, device, isActive])
}

// ---------- Settings & theme ----------

model SiteSettings {
  id           Int      @id @default(autoincrement())
  siteName     String   @default("Galaxy TV V4K")
  siteNameEn   String?  // English site name (falls back to siteName)
  logo         String?
  favicon      String?
  description  String?
  descriptionEn String?
  defaultLanguage String @default("kh") // kh | en — the site's primary language
  facebook     String?
  telegram     String?
  youtube      String?
  tiktok       String?
  instagram    String?
  twitter      String?
  contactEmail String?
  contactPhone String?
  address      String?

  // --- Live news ticker (admin-configurable, validated) ---
  tickerEnabled    Boolean @default(false)
  tickerTitle      String  @default("LIVE NEWS")
  tickerSpeed      String  @default("medium") // slow | medium | fast
  tickerDirection  String  @default("left") // left | right
  tickerCount      Int     @default(10)
  tickerRefresh    Int     @default(30) // seconds between polls
  tickerBgColor    String  @default("#0b1c39")
  tickerTextColor  String  @default("#ffffff")
  tickerAccentColor String @default("#fc3f00")
  tickerLayout      String @default("fluid") // boxed | wide | fluid

  // --- Theme tokens (admin-configurable, validated server-side) ---
  primaryColor    String  @default("#0d3fa9") // brand / primary
  secondaryColor  String  @default("#0b1c39") // dark navy
  accentColor     String  @default("#fc3f00") // highlights / breaking
  surfaceColor    String  @default("#ffffff")
  textColor       String  @default("#0b1c39")
  mutedTextColor  String  @default("#667085")
  borderColor     String  @default("#e5e7eb")

  // --- Layout/zone colors (navbar, page background, footer) ---
  bodyBgColor     String  @default("#f8f7f4") // page background behind content
  headerBgColor   String  @default("#ffffff") // navbar/utility bar background
  headerTextColor String  @default("#0b1c39") // navbar text & links
  footerBgColor   String  @default("#0b1c39") // footer background
  footerTextColor String  @default("#ffffff") // footer text & links

  // --- Layout style (container width + grid presets) ---
  layoutStyle     String  @default("boxed") // boxed (1240px) | wide (1440px) | fluid (100%)

  // --- Social share link templates (article share rail / row) ---
  // {url} and {title} are replaced with the article page URL and title.
  shareFacebook  String  @default("https://www.facebook.com/sharer/sharer.php?u={url}")
  shareTikTok    String  @default("https://www.tiktok.com/share?url={url}")
  shareTelegram  String  @default("https://t.me/share/url?url={url}&text={title}")
  shareWhatsapp  String  @default("https://wa.me/?text={title} {url}")

  fontHeading String @default("Noto Sans Khmer") // headings & titles
  fontBody    String @default("Noto Sans Khmer") // body & UI
  fontArticle String @default("Noto Sans Khmer") // article content

  fontSizeHero    Int @default(36) // desktop hero headline (px)
  fontSizeSection Int @default(24) // section headings (px)
  fontSizeCard    Int @default(18) // card titles (px)
  fontSizeBody    Int @default(16) // article body (px)

  radiusPreset String @default("sharp") // sharp | minimal | medium | rounded
  shadowPreset String @default("none") // none | subtle | medium | strong

  // --- Telegram integration (secret token — NEVER exposed publicly) ---
  telegramBotToken     String?  // stored encrypted-at-rest only on the backend
  telegramChatId       String?  // LEGACY single channel/group id or @username
  telegramDestinations String?  // JSON array of destinations (chatId, type, label, enabled)
  telegramSiteUrl      String?  // public site URL used for button links (defaults to env)
  telegramEnabled      Boolean  @default(false) // auto-publish new articles when ON
  telegramLanguageMode String   @default("both") // both | kh | en — which buttons to send
  telegramButtonKh     String   @default("🇰🇭 អានជាភាសាខ្មែរ")
  telegramButtonEn     String   @default("🇬🇧 Read in English")

  updatedAt DateTime @updatedAt
}

// ---------- Homepage builder ----------

model HomepageSection {
  id        Int      @id @default(autoincrement())
  key       String   @unique // e.g. breaking, hero, weekly, whats-new, latest, video, recent
  label     String
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  config    String?  // optional JSON with per-section options (validated)
  updatedAt DateTime @updatedAt

  @@index([enabled, sortOrder])
}

// ---------- Navigation builder ----------

model NavigationItem {
  id        Int      @id @default(autoincrement())
  label     String
  labelEn   String?  // English label (falls back to label)
  type      String   @default("link") // home | category | page | link
  value     String?  // slug/URL depending on type
  config    String?  // JSON: {"layout":"grid|list","columns":2-4}
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// ---------- Facebook Live Streams ----------

model LiveStream {
  id            Int       @id @default(autoincrement())
  titleKh      String
  titleEn      String?
  descriptionKh String?
  descriptionEn String?
  facebookUrl  String
  thumbnailUrl String?
  status       String    @default("DRAFT") // DRAFT | SCHEDULED | LIVE | ENDED | DISABLED
  visibility   String    @default("HOMEPAGE") // HOMEPAGE | PAGE_ONLY | HIDDEN
  isHomepage   Boolean   @default(false)
  isFeatured   Boolean   @default(false)
  displayOrder Int       @default(0)
  startAt      DateTime?
  endAt        DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([isHomepage])
  @@index([isFeatured])
  @@index([startAt])
  @@index([displayOrder])
}

// ---------- Activity & contact ----------

model ActivityLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  Int?
  meta      String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String?
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([createdAt])
}
