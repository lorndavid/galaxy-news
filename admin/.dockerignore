# ============================================================
# Admin .dockerignore
# ============================================================

# ── Dependencies ──
node_modules
.npm

# ── Build output ──
dist
*.tsbuildinfo

# ── Environment secrets ──
.env
.env.*
!.env.example

# ── Git ──
.git
.gitignore

# ── IDE / editor ──
.vscode
.idea
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Logs ──
*.log
logs

# ── Test artifacts ──
test-results
coverage
playwright-report

# ── Docker ──
Dockerfile*
docker-compose*
.dockerignore
