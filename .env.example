# ============================================================
# Galaxy TV V4K — Production Environment Variables
# ============================================================
#
# HOW THIS WORKS:
#   Your PC runs Docker (frontend + admin + backend + DB)
#   Cloudflare Tunnel exposes everything to the internet
#   Users visit https://www.galaxytv4k.online on any device
#
# Architecture:
#   User browser → Cloudflare → Tunnel → Docker (your PC)
#     www.galaxytv4k.online  → localhost:3000 (frontend nginx)
#     admin.galaxytv4k.online → localhost:3001 (admin nginx)
#     api.galaxytv4k.online  → localhost:4000 (backend API)
#     media.galaxytv4k.online → Cloudflare R2 (images)
#
# ============================================================


# ============================================================
# 1. DATABASE — PostgreSQL
# ============================================================
# These values must match between POSTGRES_* and DATABASE_URL

POSTGRES_DB=galaxy_tv
POSTGRES_USER=galaxy_admin
POSTGRES_PASSWORD=YOUR_STRONG_PASSWORD_HERE

# This is built automatically by docker-compose from the values above:
# DATABASE_URL=postgresql://galaxy_admin:YOUR_STRONG_PASSWORD_HERE@postgres:5432/galaxy_tv


# ============================================================
# 2. AUTHENTICATION — JWT
# ============================================================
# Generate a secure secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

JWT_SECRET=YOUR_96_CHARACTER_RANDOM_STRING_HERE
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7


# ============================================================
# 3. CLOUDFLARE R2 — Image Storage
# ============================================================
# Get these values:
#   1. Log into https://dash.cloudflare.com
#   2. Go to R2 (left sidebar)
#   3. Account ID is shown on the right sidebar
#   4. Click "Manage R2 API Tokens" (top right)
#   5. Create a token with "Object Read & Write" permission
#   6. Copy the Access Key ID and Secret Access Key
#
# Your bucket must have public access enabled:
#   R2 → your bucket → Settings → Public Access → enable

R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=news-media

# Public URL for images. This is what users see in their browser.
# Option A — Custom domain (recommended, set up in R2 bucket settings):
R2_PUBLIC_URL=https://media.galaxytv4k.online
# Option B — R2.dev built-in URL (if you didn't set up custom domain):
# R2_PUBLIC_URL=https://news-media.YOUR_ACCOUNT_ID.r2.dev


# ============================================================
# 4. DOMAIN URLs — Used by backend for CORS + redirects
# ============================================================
# These MUST match your actual Cloudflare Tunnel subdomains

FRONTEND_URL=https://www.galaxytv4k.online
ADMIN_URL=https://admin.galaxytv4k.online
PUBLIC_SITE_URL=https://www.galaxytv4k.online
TELEGRAM_API_BASE=https://api.telegram.org


# ============================================================
# 5. DOCKER COMPOSE — Backend Environment Variables
# ============================================================
# These are passed to the backend container automatically

NODE_ENV=production
PORT=4000
REDIS_URL=redis://redis:6379
