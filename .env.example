[TEMPLATE]
# ============================================================
# Navatra 4K TV — News Platform environment variables
# ============================================================

# --- Docker Compose (root .env) ------------------------------
# Credentials for the PostgreSQL container started by:
#   docker compose up -d db
POSTGRES_USER=navatra
POSTGRES_PASSWORD=navatra_dev_pw
POSTGRES_DB=navatra
POSTGRES_PORT=5432

# Public URLs when the whole stack runs in Docker
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# --- Backend (backend/.env) ----------------------------------
NODE_ENV=development
PORT=4000

# PostgreSQL — the DB runs in Docker (see above); local dev connects to it
DATABASE_URL="postgresql://navatra:navatra_dev_pw@localhost:5432/navatra?schema=public"

# Auth secrets — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Cloudinary (optional — when unset, uploads fall back to local disk in backend/uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS — where the public site and admin are served from (dev mode)
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Optional contact-form email relay (when unset, messages are stored in DB only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Public frontend (frontend/.env.local) --------------------
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_PUBLIC_BASE_URL=http://localhost:4000

# --- Admin (admin/.env.local) ---------------------------------
VITE_API_BASE_URL=http://localhost:4000/api/v1
