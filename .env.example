# ============================================================
# Galaxy TV V4K — News Platform environment variables
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=galaxy_tv
POSTGRES_USER=galaxy_admin
POSTGRES_PASSWORD=change-me-to-a-strong-password

# --- Cloudflare R2 (S3-compatible object storage) ---
# Get these from: Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=news-media
# Public URL for serving images. Options:
#   1. Custom domain (recommended): https://media.galaxytv4k.online
#   2. R2.dev public: https://news-media.<account-id>.r2.dev
R2_PUBLIC_URL=https://media.galaxytv4k.online

# --- Docker Compose (root .env) ---
FRONTEND_URL=https://www.galaxytv4k.online
ADMIN_URL=https://admin.galaxytv4k.online
PUBLIC_SITE_URL=https://www.galaxytv4k.online
TELEGRAM_API_BASE=https://api.telegram.org

# --- Backend (backend/.env) ---
NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://galaxy_admin:change-me-to-a-strong-password@postgres:5432/galaxy_tv

# Auth secrets — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Redis
REDIS_URL=redis://redis:6379

# CORS
FRONTEND_URL=https://www.galaxytv4k.online
ADMIN_URL=https://admin.galaxytv4k.online

# --- Public frontend (frontend/.env.local) ---
VITE_API_BASE_URL=https://api.galaxytv4k.online/api/v1
VITE_PUBLIC_BASE_URL=https://api.galaxytv4k.online

# --- Admin (admin/.env.local) ---
VITE_API_BASE_URL=https://api.galaxytv4k.online/api/v1
