# ============================================================
# Navatra 4K TV — News Platform environment variables
# ============================================================

# --- Docker Compose (root .env) ------------------------------
# Public URLs when the whole stack runs in Docker
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# MinIO credentials (also used by the minio container + backend)
MINIO_ACCESS_KEY=navatra
MINIO_SECRET_KEY=navatra_dev_secret

# --- Backend (backend/.env) ----------------------------------
NODE_ENV=development
PORT=4000

# SQLite — a file database stored on a persistent Docker volume.
# Local dev:  file:./dev.db
DATABASE_URL="file:./dev.db"

# Auth secrets — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Redis — API cache (Docker service `redis`). When unavailable the app
# falls back to an in-memory cache and keeps serving from SQLite.
REDIS_URL=redis://localhost:6379

# MinIO — object storage (Docker service `minio`). When unavailable the
# app falls back to local disk under backend/uploads.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=navatra
MINIO_SECRET_KEY=navatra_dev_secret
MINIO_BUCKET=news-media
# Serve objects through the API proxy so images work in dev + Docker.
MINIO_PUBLIC_URL=/minio

# CORS — where the public site and admin are served from (dev mode)
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Optional contact-form email relay (when unset, messages are stored in DB only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Public frontend (frontend/.env.local) --------------------
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_PUBLIC_BASE_URL=http://localhost:4000

# --- Admin (admin/.env.local) ---------------------------------
VITE_API_BASE_URL=http://localhost:4000/api/v1
