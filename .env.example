# ============================================================
# Galaxy TV V4K — Environment Variables
# ============================================================
# Copy to .env and fill in your values.
# NEVER commit .env to Git.
#
# For local development: use docker compose up -d
# For production: use docker compose -f docker-compose.prod.yml up -d
# ============================================================

# ── PostgreSQL ──
POSTGRES_DB=galaxy_tv
POSTGRES_USER=galaxy_admin
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# ── JWT Authentication ──
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_96_CHARS
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# ── Cloudflare R2 (Image Storage) ──
# Get from: Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=news-media
R2_PUBLIC_URL=https://media.galaxytv4k.online

# ── Domain URLs ──
# Production: these point to your Vercel deployments
PUBLIC_SITE_URL=https://www.galaxytv4k.online
FRONTEND_URL=https://www.galaxytv4k.online
ADMIN_URL=https://admin.galaxytv4k.online
FRONTEND_ORIGIN=https://www.galaxytv4k.online
ADMIN_ORIGIN=https://admin.galaxytv4k.online

# ── Telegram (optional) ──
TELEGRAM_API_BASE=https://api.telegram.org

# ── Cloudflare Tunnel (production only) ──
# Get from: Cloudflare Dashboard → Zero Trust → Networks → Tunnels
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here
