# ============================================================
# Root .dockerignore — backend build context
# ============================================================
# This file reduces the Docker build context sent to the daemon.
# The backend Dockerfile is built from the repo root, so we must
# exclude everything the backend doesn't need.

# ── Dependencies (always re-installed in container) ──
node_modules
**/node_modules
.npm

# ── Build output ──
dist
**/dist
*.tsbuildinfo

# ── Database files ──
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite-journal

# ── Environment secrets ──
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# ── Git ──
.git
.gitignore

# ── Docker (don't send Dockerfiles into the build context) ──
docker-compose*.yml
**/Dockerfile*

# ── Documentation ──
docs
*.md
LICENSE
README*

# ── IDE / editor ──
.vscode
.idea
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Test artifacts ──
test-results
coverage
playwright-report
.nyc_output

# ── Logs ──
logs
*.log

# ── Frontend / Admin (not needed for backend build) ──
frontend
admin

# ── Backups ──
backups

# ── Scripts ──
scripts

# ── Cloudflare ──
cloudflared

# ── Misc ──
*.tmp
*.bak
*.orig
